{
  "name": "dsh-pet-hud",
  "version": "0.1.0",
  "description": "DeepSeek Harness floating pet: account balance, spend-since-reset, peak-hour marker, unread-session reactions.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pet",
    "balance",
    "widget"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "preview.png",
    "preview-idle.gif",
    "preview-happy.gif",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm run build && npm test"
  }
}
